# ==============================================================================
# Drishti-Edge Environment Configuration Template (.env.example)
# Copy this file to .env and configure local paths and settings.
# DO NOT commit the .env file containing local or sensitive settings.
# ==============================================================================

# Application Environment (development, staging, production)
DRISHTI_ENV=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Local Storage Paths
SQLITE_DB_PATH=data/drishti_audit.db
VIDEO_INPUT_DIR=data/videos/
OUTPUT_DIR=data/output/

# Vision & Model Parameters
YOLO_MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Privacy Settings
ENABLE_FACE_BLURRING=true
ENABLE_LICENSE_PLATE_BLURRING=true
PERSIST_RAW_FRAMES=false
